<!-- Insert into ~/.config/openbox/menu.xml under root-menu -->
<separator label="Application" />

<item label="Open PVEClient">
  <action name="Execute">
    <command>/home/pveclient/bin/pveclient-open.sh</command>
  </action>
</item>

<item label="Terminal">
  <action name="Execute">
    <command>lxterminal</command>
  </action>
</item>
<separator label="Setting" />
<item label="Network Setting">
  <action name="Execute">
    <command>nm-connection-editor</command>
  </action>
</item>

<item label="Sound Setting">
  <action name="Execute">
    <command>pavucontrol</command>
  </action>
</item>

<item label="Screen Setting">
  <action name="Execute">
    <command>arandr</command>
  </action>
</item>

<item label="Printer Setting">
  <action name="Execute">
    <command>system-config-printer</command>
  </action>
</item>

<separator label="Power" />

<item label="Reboot">
  <action name="Execute">
    <command>lxterminal -e "sudo reboot"</command>
  </action>
</item>

<item label="Shutdown">
  <action name="Execute">
    <command>lxterminal -e "sudo poweroff"</command>
  </action>
</item>
